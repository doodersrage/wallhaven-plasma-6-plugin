[Desktop Entry]
Type=Service
Name=Wallhaven
Name[en]=Wallhaven
Comment=Control Wallhaven wallpapers from KRunner
Comment[en]=Control Wallhaven wallpapers from KRunner
Icon=preferences-desktop-wallpaper
X-KDE-ServiceTypes=Plasma/Runner
X-KDE-PluginInfo-Name=org.robertsm.wallhaven
X-KDE-PluginInfo-Version=1.5.0
X-KDE-PluginInfo-License=GPL-2.0-or-later
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.robertsm.Wallhaven
X-Plasma-DBusRunner-Path=/runner
X-Plasma-Runner-Unique-Results=true
X-Plasma-Runner-Syntaxes=wh :q:,wallhaven :q:,wallhaven search :q:
X-Plasma-Runner-Syntax-Descriptions=Wallhaven command,Wallhaven command,Search Wallhaven for :q:
