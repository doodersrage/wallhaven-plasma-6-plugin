[Unit]
Description=Wallhaven wallpaper D-Bus control service
After=graphical-session.target dbus.socket
Wants=dbus.socket

[Service]
Type=dbus
BusName=org.robertsm.Wallhaven
ExecStart=/usr/bin/python3 @INSTALL_DIR@/tools/wallhaven-dbus.py
Restart=on-failure
Environment=WALLHAVEN_SYNC_GROUP=default

[Install]
WantedBy=default.target
