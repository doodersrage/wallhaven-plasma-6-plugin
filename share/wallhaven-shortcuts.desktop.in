[Desktop Entry]
Type=Application
Name=Wallhaven Global Shortcuts
Comment=Meta+Alt+arrows for next, previous, pause, and reload
Exec=@INSTALL_DIR@/bin/wallhaven-shortcuts
Icon=preferences-desktop-wallpaper
Categories=Utility;
StartupNotify=false
X-KDE-autostart-after=panel
X-KDE-StartupNotify=false
X-GNOME-Autostart-enabled=true
