[Unit]
Description=Wallhaven wallpaper D-Bus control service
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/share/wallhaven-plasma/tools/wallhaven-dbus.py
Restart=on-failure
Environment=WALLHAVEN_SYNC_GROUP=default

[Install]
WantedBy=default.target
